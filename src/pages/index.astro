---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5" aria-label="Filter games" data-testid="game-filters">
            <div class="grid gap-6 md:grid-cols-[2fr_1fr]">
              <fieldset>
                <legend class="mb-3 font-medium text-slate-100">Categories <span class="text-sm font-normal text-slate-400">(choose any)</span></legend>
                <div class="flex flex-wrap gap-3">
                  {categories.map((category) => (
                    <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-700 px-3 py-2 text-slate-200 hover:bg-slate-700">
                      <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                        data-testid={`category-filter-${category.id}`}
                      />
                      <span>{category.name}</span>
                    </label>
                  ))}
                </div>
              </fieldset>

              <div>
                <label for="publisher-filter" class="mb-3 block font-medium text-slate-100">Publisher</label>
                <select
                  id="publisher-filter"
                  name="publisher"
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid="publisher-filter"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                  ))}
                </select>
              </div>
            </div>

            <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
              <p id="filter-results" class="text-sm text-slate-300" role="status" aria-live="polite" aria-atomic="true" data-testid="filter-results">
                Showing {games.length} {games.length === 1 ? 'game' : 'games'}.
              </p>
              <button
                type="button"
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="clear-filters"
              >
                Clear filters
              </button>
            </div>
          </form>

          <p class="mb-6 rounded-lg border border-slate-700 bg-slate-800 p-4 text-slate-300" data-testid="no-filter-results" hidden>
            No games match these filters. Try changing or clearing your selections.
          </p>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');

  if (filterForm) {
    const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const categoryInputs = Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]'));
    const publisherSelect = filterForm.querySelector<HTMLSelectElement>('select[name="publisher"]');
    const resultsStatus = filterForm.querySelector<HTMLElement>('[data-testid="filter-results"]');
    const noResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');
    const clearButton = filterForm.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');

    const updateGames = (): void => {
      const selectedCategories = new Set(
        categoryInputs.filter((input) => input.checked).map((input) => input.value),
      );
      const selectedPublisher = publisherSelect?.value ?? '';
      let visibleCount = 0;

      for (const card of gameCards) {
        const matchesCategory =
          selectedCategories.size === 0 ||
          (card.dataset.categoryId !== undefined && selectedCategories.has(card.dataset.categoryId));
        const matchesPublisher =
          selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
        const isVisible = matchesCategory && matchesPublisher;

        card.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      }

      if (resultsStatus) {
        resultsStatus.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}.`;
      }
      if (noResults) noResults.hidden = visibleCount !== 0;
    };

    filterForm.addEventListener('change', updateGames);
    clearButton?.addEventListener('click', () => {
      for (const input of categoryInputs) input.checked = false;
      if (publisherSelect) publisherSelect.value = '';
      updateGames();
    });
  }
</script>
